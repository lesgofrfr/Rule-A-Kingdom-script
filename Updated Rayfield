-- Notification Function
local function showPopup(message, isSuccess, duration)
    Rayfield:Notify({
        Title = isSuccess and "Success" or "Error",
        Content = message,
        Duration = duration or 4,
        Image = isSuccess and 4483362458 or 4483362748, -- Success/Error icons
        Actions = {
            Ignore = {
                Name = "OK",
                Callback = function() end
            }
        }
    })
end

-- Jail Function (Shared Logic)
local function jailTarget(input, isSpam)
    local jailed = {}
    local inputLower = input:lower()
    updateRemotes()
    if inputLower == "all" or inputLower == "everyone" then
        for _, p in ipairs(Players:GetPlayers()) do
            local name = p.Name:lower()
            local display = p.DisplayName:lower()
            if p ~= player and not excludedPlayers[name] and not excludedPlayers[display] and not jailExcludedPlayers[name] and not jailExcludedPlayers[display] then
                local success = false
                if criminalSystem then
                    logDebug("Trying CriminalSystem for " .. p.Name .. (isSpam and " (Spam)" or ""))
                    success = pcall(function()
                        criminalSystem:FireServer("Arrested", p)
                    end)
                end
                if not success then
                    logDebug("CriminalSystem failed, using fallback for " .. p.Name .. (isSpam and " (Spam)" or ""))
                    success = pcall(function()
                        if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                            p.Character.HumanoidRootPart.CFrame = CFrame.new(Vector3.new(100, 50, 100))
                        end
                    end)
                end
                if success then
                    table.insert(jailed, p.DisplayName)
                else
                    logDebug("Failed to jail " .. p.Name .. (isSpam and " (Spam)" or ""))
                end
            end
        end
    else
        for _, p in ipairs(Players:GetPlayers()) do
            local name = p.Name:lower()
            local display = p.DisplayName:lower()
            if (name == inputLower or name:sub(1, #inputLower) == inputLower or display == inputLower or display:sub(1, #inputLower) == inputLower)
                and not excludedPlayers[name] and not excludedPlayers[display] and not jailExcludedPlayers[name] and not jailExcludedPlayers[display] then
                local success = false
                if criminalSystem then
                    logDebug("Trying CriminalSystem for " .. p.Name .. (isSpam and " (Spam)" or ""))
                    success = pcall(function()
                        criminalSystem:FireServer("Arrested", p)
                    end)
                end
                if not success then
                    logDebug("CriminalSystem failed, using fallback for " .. p.Name .. (isSpam and " (Spam)" or ""))
                    success = pcall(function()
                        if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                            p.Character.HumanoidRootPart.CFrame = CFrame.new(Vector3.new(100, 50, 100))
                        end
                    end)
                end
                if success then
                    table.insert(jailed, p.DisplayName)
                else
                    logDebug("Failed to jail " .. p.Name .. (isSpam and " (Spam)" or ""))
                end
                break
            end
        end
    end
    return jailed
end

