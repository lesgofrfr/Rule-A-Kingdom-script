    damageEvent = ReplicatedStorage:FindFirstChild("DamageEvent")
    healEvent = ReplicatedStorage:FindFirstChild("HealEvent")
    toolGive = ReplicatedStorage:FindFirstChild("ToolGive") -- Sigma Spy
    logDebug(criminalSystem and "CriminalSystem found" or "CriminalSystem not found")
    logDebug(damageEvent and "DamageEvent found" or "DamageEvent not found")
    logDebug(healEvent and "HealEvent found" or "HealEvent not found")
    logDebug(toolGive and "ToolGive found" or "ToolGive not found")
end
