-- Debug Logging
local function logDebug(message)
    print("[Infinity Hub Debug]: " .. message)
end

-- Universal Remote Event Scanner
local function scanRemotes()
    local detectedRemotes = {}
    local success, err = pcall(function()
        for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
            if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                table.insert(detectedRemotes, {Name = obj.Name, Type = obj.ClassName, Path = obj:GetFullName()})
                logDebug("Remote found: " .. obj.Name .. " (" .. obj.ClassName .. ") at " .. obj:GetFullName())
            end
        end
    end)
    if not success then
        logDebug("Remote scan failed: " .. tostring(err))
    elseif #detectedRemotes == 0 then
        logDebug("No remotes found in ReplicatedStorage.")
    else
        logDebug("Scan complete: " .. #detectedRemotes .. " remotes discovered.")
        for i, remote in ipairs(detectedRemotes) do
            logDebug("Remote #" .. i .. ": Name = " .. remote.Name .. ", Type = " .. remote.Type .. ", Path = " .. remote.Path)
        end
    end
    return detectedRemotes
end

-- Locate Game Remotes
local criminalSystem, damageEvent, healEvent, toolGive
local function updateRemotes()
